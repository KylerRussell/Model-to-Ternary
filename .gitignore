# Virtual environment
.venv/

# Generated output trees (rotation, recovery, distillation, experiments) — ANY output-prefixed dir
output*/
# NOTE: experiment DRIVERS are tracked in experiments/sweep/ — only OUTPUTS are ignored here.
# See experiments/sweep/README.md; they were untracked until 2026-09-14 (T0.1).
*.gguf

# Logs (pipeline + diagnostics). logs/*.txt and logs/RESULTS_SUMMARY.md ARE tracked — they are the
# condensed experimental record and the only surviving copy of most numbers.
*.log

# Cached tensors (teacher caches, eval refs, etc.)
*.pt

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# Model weights (don't commit these)
*.safetensors
*.bin
*.msgpack

# Calibration corpus (tools/fetch_data.py repopulates it from the Hub; ~20 GB of parquet).
# The manifest in src/calib_sources.py is the tracked artifact — the bytes are not.
data/
*.parquet

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Per-host path overrides (see env.sh)
env.local.sh

# Scratch
_snap_state/
_adam_state/
_teacher_offload/
